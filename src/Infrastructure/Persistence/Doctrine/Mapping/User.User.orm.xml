<?xml version="1.0" encoding="UTF-8"?>
<!-- Domain\User\User sınıfının veritabanı eşlemesi. Tablo ve sütun adları eski şemayla aynı. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\User\User">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="email" type="string" length="180" unique="true"/>
        <field name="roles" type="json"/>
        <field name="passwordHash" type="string" column="password" length="255"/>
        <field name="leaveBalance" type="integer">
            <options>
                <option name="default">14</option>
            </options>
        </field>
        <many-to-one field="department" target-entity="App\Domain\User\Department">
            <join-column name="department_id" nullable="true"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
