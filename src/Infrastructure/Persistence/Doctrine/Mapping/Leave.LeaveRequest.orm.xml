<?xml version="1.0" encoding="UTF-8"?>
<!-- Domain\Leave\LeaveRequest. "period" gömülü nesnesi start_date / end_date sütunlarına yazılır. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Leave\LeaveRequest">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="reason" type="string" length="255"/>
        <field name="status" type="string" length="50" enum-type="App\Domain\Leave\LeaveStatus"/>
        <field name="rejectionReason" type="text" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" nullable="true"/>
        <embedded name="period" class="App\Domain\Leave\LeavePeriod" use-column-prefix="false"/>
        <many-to-one field="employee" target-entity="App\Domain\User\User">
            <join-column name="user_id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
